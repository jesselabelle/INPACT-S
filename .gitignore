# --- System Files ---
.DS_Store
Thumbs.db
~$*

# --- Stata Archive ---
# Ignore the archive folder completely
code/stata/archive/
code/stata/authors_only/

# --- Data Folder Rules ---

# 1. Ignore EVERYTHING in data by default
data/*

# 2. Allow Git to enter "data/raw" (but ignore its contents by default)
!data/raw/
data/raw/*

# 3. Allow Git to enter "data/raw/crosswalks" (but ignore its contents by default)
!data/raw/crosswalks/
data/raw/crosswalks/*

# 4. Finally, un-ignore ONLY the specific files you want to keep
!data/raw/crosswalks/wipo_st3.csv
!data/raw/crosswalks/regional_authorities.xlsx

# 5. Allow Git to enter "datasets" (but ignore its contents by default)
!datasets/
datasets/*

# 6. Finally, un-ignore ONLY the specific files you want to keep
!datasets/README.txt
!datasets/Discrepancies in INPACT-S V1.0 Using New Code.log

# --- Paper Replication and Local Audit Material ---
# The paper replication package is maintained in a separate repository.
code/stata/replication/
replication_audit/
replication_output/
tmp/
